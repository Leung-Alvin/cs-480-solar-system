# Skybox cube for cross-layout texture (viewing from inside)
# Standard cross: Left/Front/Right/Back in middle row, Top above Front, Bottom below Front

# === VERTICES ===
# Front face (+Z)
v -1.0 -1.0  1.0
v  1.0 -1.0  1.0
v  1.0  1.0  1.0
v -1.0  1.0  1.0

# Back face (-Z)
v  1.0 -1.0 -1.0
v -1.0 -1.0 -1.0
v -1.0  1.0 -1.0
v  1.0  1.0 -1.0

# Top face (+Y)
v -1.0  1.0  1.0
v  1.0  1.0  1.0
v  1.0  1.0 -1.0
v -1.0  1.0 -1.0

# Bottom face (-Y)
v -1.0 -1.0 -1.0
v  1.0 -1.0 -1.0
v  1.0 -1.0  1.0
v -1.0 -1.0  1.0

# Left face (-X)
v -1.0 -1.0 -1.0
v -1.0 -1.0  1.0
v -1.0  1.0  1.0
v -1.0  1.0 -1.0

# Right face (+X)
v  1.0 -1.0  1.0
v  1.0 -1.0 -1.0
v  1.0  1.0 -1.0
v  1.0  1.0  1.0

# === TEXTURE COORDINATES ===
# Front face - column 1 (0.25-0.50), row 1 (0.333-0.667)
vt 0.2500 0.3333
vt 0.5000 0.3333
vt 0.5000 0.6667
vt 0.2500 0.6667

# Back face - column 3 (0.75-1.0), row 1 (0.333-0.667)
vt 0.7500 0.3333
vt 1.0000 0.3333
vt 1.0000 0.6667
vt 0.7500 0.6667

# Top face - column 1 (0.25-0.50), row 0 (0.0-0.333)
vt 0.2500 0.0000
vt 0.5000 0.0000
vt 0.5000 0.3333
vt 0.2500 0.3333

# Bottom face - column 1 (0.25-0.50), row 2 (0.667-1.0)
vt 0.2500 0.6667
vt 0.5000 0.6667
vt 0.5000 1.0000
vt 0.2500 1.0000

# Left face - column 0 (0.0-0.25), row 1 (0.333-0.667)
vt 0.0000 0.3333
vt 0.2500 0.3333
vt 0.2500 0.6667
vt 0.0000 0.6667

# Right face - column 2 (0.50-0.75), row 1 (0.333-0.667)
vt 0.5000 0.3333
vt 0.7500 0.3333
vt 0.7500 0.6667
vt 0.5000 0.6667

# === NORMALS (pointing inward for skybox) ===
vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn  0.0 -1.0  0.0
vn  0.0  1.0  0.0
vn  1.0  0.0  0.0
vn -1.0  0.0  0.0

# === FACES ===
# Front face - viewing from inside, so reverse winding
f 1/1/1 4/4/1 3/3/1
f 1/1/1 3/3/1 2/2/1

# Back face
f 5/5/2 8/8/2 7/7/2
f 5/5/2 7/7/2 6/6/2

# Top face
f 9/9/3 12/12/3 11/11/3
f 9/9/3 11/11/3 10/10/3

# Bottom face
f 13/13/4 16/16/4 15/15/4
f 13/13/4 15/15/4 14/14/4

# Left face
f 17/17/5 20/20/5 19/19/5
f 17/17/5 19/19/5 18/18/5

# Right face
f 21/21/6 24/24/6 23/23/6
f 21/21/6 23/23/6 22/22/6